<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="com.debmanager.Helper1">
    <method name="InstallLocalPackages">
      <arg name="paths" type="as" direction="in"/>
      <arg name="transaction" type="s" direction="out"/>
    </method>
    <method name="InstallPackages">
      <arg name="names" type="as" direction="in"/>
      <arg name="transaction" type="s" direction="out"/>
    </method>
    <method name="RemovePackages">
      <arg name="names" type="as" direction="in"/>
      <arg name="purge" type="b" direction="in"/>
      <arg name="transaction" type="s" direction="out"/>
    </method>
    <method name="UpdateCache">
      <arg name="transaction" type="s" direction="out"/>
    </method>
    <method name="Upgrade">
      <arg name="distUpgrade" type="b" direction="in"/>
      <arg name="transaction" type="s" direction="out"/>
    </method>
    <method name="AutoRemove">
      <arg name="transaction" type="s" direction="out"/>
    </method>

    <signal name="Output">
      <arg name="transaction" type="s"/>
      <arg name="text" type="s"/>
    </signal>
    <signal name="Finished">
      <arg name="transaction" type="s"/>
      <arg name="exitCode" type="i"/>
      <arg name="message" type="s"/>
    </signal>
  </interface>
</node>
